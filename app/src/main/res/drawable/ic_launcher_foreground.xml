            android:pathData="M54,15 V90 C54,90 28,75 28,50 V20 C28,20 40,15 54,15Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.1"/>

        <!-- The Fishing Hook (Central J-Shape) -->
        <!-- Hook Loop (Eye at the top) -->
        <path
            android:pathData="M54,28 A4.5,4.5 0 1,1 54,28.1 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:fillColor="#00000000"/>

