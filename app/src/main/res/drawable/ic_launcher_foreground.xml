        <path
            android:pathData="M54,32 V62 Q54,80 38,80 Q28,80 28,68 L34,68 Q34,74 38,74 Q48,74 48,62 V32"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"/>

        <!-- Hook Barb (Pointy part) -->
        <path
            android:pathData="M34,68 L30,62 L38,62 Z"
            android:fillColor="#FFFFFF"/>

        <!-- Fishing Line (connecting to the top) -->
        <path
            android:pathData="M54,12 V24"
